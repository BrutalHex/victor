[Unit]
Description=victor-agent (CHARGE-LATCH, telemetry, SSH latch)
After=network-online.target victor-firstboot.service
Wants=network-online.target victor-firstboot.service

[Service]
Type=simple
ExecStart=/usr/bin/victor-agent run
Restart=always
RestartSec=2
# Do not put OPENAI_API_KEY here. OpenAI stays on the hub.
EnvironmentFile=-/data/victor/hub.env
WorkingDirectory=/data/victor

[Install]
WantedBy=multi-user.target

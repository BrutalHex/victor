[Unit]
Description=Victor first boot: SSH ON, BLE mask flag, /data exec, hub hostname
DefaultDependencies=no
# Vector mounts /data from mount-data.service (dm-crypt userdata), after
# basic.target. Do NOT order this Before=sshd.socket: that would be a cycle
# (sshd.socket < sockets.target < basic.target < mount-data). SSH is enabled
# in the image anyway; victor-agent applies the latch state when it starts.
After=local-fs.target mount-data.service data.mount
Before=victor-agent.service victor-ble-mask.service

[Service]
Type=oneshot
ExecStart=/usr/bin/victor-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

[Unit]
Description=Victor first boot: SSH ON, BLE mask flag, /data exec, hub hostname
DefaultDependencies=no
After=local-fs.target
Before=victor-agent.service victor-ble-mask.service dropbear.service dropbear.socket sshd.socket

[Service]
Type=oneshot
ExecStart=/usr/bin/victor-firstboot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

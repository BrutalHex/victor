# Hub / robot bring-up. Copy to .env and fill. Never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=alloy
# Live web for the model: Responses API with the built-in web_search tool.
HUB_WEB_SEARCH=1
# HUB_SEARCH_MODEL=   # defaults to OPENAI_MODEL
HUB_SEARCH_TIMEOUT=15
# Local clock given to the model every turn, and an optional location hint.
HUB_TZ=Europe/Berlin
HUB_CITY=
HUB_COUNTRY=

HUB_PUBLIC_NAME=robot.mohammadabbasi.com
# Laptop Wi-Fi IP the robot uses (not the WSL NAT address).
HUB_IP=192.168.0.202
ROBOT_SSH_IP=192.168.0.6
ROBOT_SSH_KEY=keys/ssh_root_key

# 2.4 GHz only. Used by deploy/ble-bootstrap and first-flash.
WIFI_SSID=
WIFI_PASSWORD=
WIFI_AUTHTYPE=6

# HTTP URL of our .ota (recovery cannot pull HTTPS).
OTA_URL=
OTA_FILE=

# BLE pair. Face PIN after double-press on charger.
VECTOR_BLE_NAME=Vector-W1V9
VECTOR_BLE_PIN=

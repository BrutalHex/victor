# Hub / robot bring-up. Copy to .env (repo root; hub/docker-compose.yml reads ../.env)
# and fill. Never commit .env. After editing: make hub (recreates the container).

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Vector-style voice (hub/app/voicefx.py): OpenAI voice + pitch/formant up,
# metallic comb, small-speaker EQ. OPENAI_VOICE is no longer used.
HUB_VOICE=echo
HUB_VOICE_VECTOR=1        # 0 = plain OpenAI voice
HUB_VOICE_PITCH=4         # semitones up (formants follow)
HUB_VOICE_TEMPO=0.94      # <1 slower
HUB_VOICE_FX=1            # comb (+ optional ring mod)
HUB_VOICE_COMB_MS=4.5
HUB_VOICE_COMB_MIX=0.28
HUB_VOICE_RING_HZ=55
HUB_VOICE_RING_MIX=0
# HUB_VOICE_INSTRUCTIONS=   (gpt-4o-mini-tts style prompt; default in voice.py)
# Live web for the model: Responses API with the built-in web_search tool.
HUB_WEB_SEARCH=1
# HUB_SEARCH_MODEL=   # defaults to OPENAI_MODEL
HUB_SEARCH_TIMEOUT=15
# Thinking face: re-send every N s during a reply turn; stop refreshing after MAX s (robot clears ~15 s later)
HUB_THINK_REFRESH=4
HUB_THINK_MAX=120
# STT: pinned language ("" = auto-detect), trim VAD silence before upload
HUB_LANGS=en,de,fa        # spoken languages; anything else is retried once or dropped
HUB_STT_LANGUAGE=         # empty = auto-detect within HUB_LANGS; set e.g. en to pin
HUB_LANG_RETRY=1          # one forced-language STT retry for a loud, rejected utterance
HUB_DROP_RMS_RATIO=1.2    # drop utterances quieter than this x noise floor (before STT)
HUB_STT_TRIM=1
# Noise-turn gate (checked when the VAD closes, before any thinking face / STT). Defaults tuned on room
# recordings with hub/app/vad_replay.py: a turn needs >=160 ms above threshold and either a 140 ms voiced
# run at SNR>=6 or SNR>=15 with a little voicing. Packets the robot flags as recorded while its own motors
# ran never feed the noise floor and need 3x the threshold.
# HUB_VAD_MIN_SPEECH_FRAMES=8  HUB_VAD_VOICED_RUN=7  HUB_VAD_MIN_SNR=6  HUB_VAD_LOUD_SNR=15  HUB_VAD_ROBOT_NOISE_BOOST=3
# Spoken reply cap (whole sentences); web search can return whole forecast tables
HUB_REPLY_MAX_CHARS=300
# Local clock given to the model every turn, and an optional location hint.
HUB_TZ=Europe/Berlin
# Stock Vector voice commands (hub/app/intents.py; list at GET /intents). 0 = everything goes to chat.
HUB_INTENTS=1
# HUB_ROBOT_BIRTHDAY=2019-01-15   # for "how old are you" (YYYY-MM-DD)
HUB_CITY=
HUB_COUNTRY=

# Face-to-name (hub only). Key stays on the hub; HUB_FACE_API_KEY_VAR names the .env variable holding it.
HUB_FACE_ID=1
HUB_FACE_BASE_URL=https://integrate.api.nvidia.com/v1
HUB_FACE_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
HUB_FACE_API_KEY_VAR=NVIDIA_API_KEY
NVIDIA_API_KEY=
# Faces are found and matched LOCALLY on the hub (YuNet + SFace, CPU). NVIDIA is asked only when the local
# match is uncertain: for "who am I?" and, in the background, only when it could lead to a greeting.
# (Comments on their own lines: docker env_file does not strip trailing "# ..." from values.)
# Below this NVIDIA confidence the name is not used:
HUB_FACE_MIN_CONF=0.7
HUB_FACE_TIMEOUT=25
# Extra tries on 429/5xx; every try counts against the budget below:
HUB_FACE_RETRIES=1
# Older camera frame = "can't see you":
HUB_FACE_FRAME_MAX_AGE_S=5

# Hard NVIDIA budget, shared by every caller, persisted in hub/data/nvidia_budget.json (shown on /status and /ui).
# NVIDIA_RPM: calls per rolling minute (endpoint limit is 30). NVIDIA_MAX_CALLS: cap per NVIDIA_CAP_WINDOW,
# day (resets at local midnight, HUB_TZ) or total (never resets; delete the json to reset). Cap hit = local only.
NVIDIA_RPM=20
NVIDIA_MAX_CALLS=400
NVIDIA_CAP_WINDOW=day
# Background (greeting) NVIDIA checks: max per hour, and none once only this many calls are left.
HUB_FACE_BG_NVIDIA=1
HUB_FACE_BG_MAX_PER_HOUR=6
HUB_FACE_BG_RESERVE=50

# Local matcher: SFace cosine >= SURE = that person (no call); < UNSURE = nobody enrolled (no call);
# in between = uncertain. Measured 10 Oct: owner across sessions 0.51-0.72, 63 strangers <= 0.31.
HUB_FACE_LOCAL=1
HUB_FACE_LOCAL_SURE=0.50
HUB_FACE_LOCAL_UNSURE=0.32
# A clear face: detector score >= 0.8, at least this many px wide in the 640x480 frame (~2 m), roughly frontal.
HUB_FACE_MIN_PX=48
# Same face seen again within this many seconds reuses the last answer (no new call):
HUB_FACE_CACHE_S=600
# Scan the newest camera frame every 1 s while a face is around, every 2 s otherwise:
HUB_FACE_SCAN_S=1.0
HUB_FACE_IDLE_SCAN_S=2.0

# Spontaneous greeting of known faces ("Hi Mohammad!" + happy eyes), once per person per cooldown,
# never while speaking/thinking or within HUB_GREET_QUIET_S of a voice turn.
HUB_GREET=1
HUB_GREET_COOLDOWN_S=7200
HUB_GREET_QUIET_S=20
# While asleep: look = look up + happy eyes, no speech; speak = say hi too; off = nothing.
HUB_GREET_ASLEEP=look
# Unknown faces: 1 = while awake, ask once "I don't think we've met, what's your name?" (cooldown 6 h).
HUB_GREET_UNKNOWN=0
HUB_GREET_UNKNOWN_COOLDOWN_S=21600

HUB_PUBLIC_NAME=robot.mohammadabbasi.com
# Laptop Wi-Fi IP the robot uses (not the WSL NAT address).
HUB_IP=192.168.0.202
ROBOT_SSH_IP=192.168.0.6
ROBOT_SSH_KEY=keys/ssh_root_key

# 2.4 GHz only. Used by deploy/ble-bootstrap and first-flash.
WIFI_SSID=
WIFI_PASSWORD=
WIFI_AUTHTYPE=6

# HTTP URL of our .ota (recovery cannot pull HTTPS).
OTA_URL=
OTA_FILE=

# BLE pair. Face PIN after double-press on charger.
VECTOR_BLE_NAME=Vector-W1V9
VECTOR_BLE_PIN=

# Command-or-chat router: one small text-only OpenAI call per transcript (strict JSON schema).
# Short exact pattern matches (<= HUB_ROUTER_FAST_WORDS words) skip it. HUB_ROUTER=0 = patterns only.
# HUB_ROUTER=1  HUB_ROUTER_MODEL=gpt-4o-mini  HUB_ROUTER_MIN_CONF=0.6  HUB_ROUTER_TIMEOUT_S=4  HUB_ROUTER_FAST_WORDS=4
# Speech volume level 1..5 used when hub/data/volume.txt does not exist yet ("volume up/down/max" persist there).
# HUB_VOLUME_DEFAULT=5

# Wake word session: asleep until "Hey Vector" (or one backpack press), awake until "Stop Vector".
# Asleep, only speech-to-text runs; a transcript without the wake phrase is dropped silently.
# HUB_WAKE=0 = always listening (as before). HUB_SESSION_IDLE_S: end a session after N s without a turn (0 = never).
HUB_WAKE=1
HUB_SESSION_IDLE_S=0
# HUB_SESSION_HISTORY=8   # turns kept as chat context within a session
# HUB_WAKE_CHIME=1        # soft chime with the wake face

# Drive speeds (robot side). `make sync` copies these four numbers to
# /data/victor/drive.env on the robot; the agent clamps them to its safe range
# (speeds 20..140 mm/s so the cliff stop stays within ~25 mm, turn 30..300
# deg/s, accel 100..1000 mm/s^2). Unset = defaults below. Old fixed speed was 40.
VECTOR_EXPLORE_MMPS=120
VECTOR_DRIVE_MMPS=120
VECTOR_TURN_DPS=180
VECTOR_ACCEL_MMPS2=400

# Hub / robot bring-up. Copy to .env and fill. Never commit .env.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=alloy

HUB_PUBLIC_NAME=robot.mohammadabbasi.com
ROBOT_SSH_IP=192.168.0.6
ROBOT_SSH_KEY=keys/ssh_root_key

# 2.4 GHz only. Used by deploy/ble-bootstrap and first-flash.
WIFI_SSID=
WIFI_PASSWORD=
WIFI_AUTHTYPE=6

# HTTP URL of our .ota (recovery cannot pull HTTPS).
OTA_URL=
OTA_FILE=

# BLE pair. Face PIN after double-press on charger.
VECTOR_BLE_NAME=Vector-W1V9
VECTOR_BLE_PIN=
